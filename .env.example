# Hugging Face read token; needed for gated datasets.
HF_TOKEN=
# GitHub token; raises rate limits, needed for private repos.
GITHUB_TOKEN=
# Zenodo token; only needed for restricted records.
ZENODO_TOKEN=
# Kaggle username from kaggle.json (Settings -> API).
KAGGLE_USERNAME=
# Kaggle key from the same kaggle.json file.
KAGGLE_KEY=
# Roboflow API key from your workspace settings page.
ROBOFLOW_API_KEY=
# Optional data folder outside the repo (woofdecoder only); empty uses data/.
WOOFDECODER_DATA_DIR=
