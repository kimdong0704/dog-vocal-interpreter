# Copy this file to .env and fill in your own values.

# Hugging Face read token: https://huggingface.co/settings/tokens
# Optional: removes the "unauthenticated requests" warning and raises rate limits.
HF_TOKEN=

# Optional: keep datasets outside the repo, e.g. D:/woofdecoder-data
# Leave empty to use <repo root>/data.
WOOFDECODER_DATA_DIR=
